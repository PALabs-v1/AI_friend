# -----------------------------------------------------------------------------
# AI FRIEND — ENVIRONMENT VARIABLES
# Copy to `.env` and fill in actual values.
# DO NOT COMMIT the real `.env` files.
# -----------------------------------------------------------------------------

# Set to "production" once every secret below has been changed from its
# placeholder value (#162). Doing so activates a startup check that refuses to
# boot if DATABASE_URL, NEO4J_PASSWORD, NEO4J_AUTH, LIVEKIT_API_KEY, or
# LIVEKIT_API_SECRET still contain the literal placeholder text this file
# ships with -- the exact failure mode of copying this file and forgetting to
# edit it. Set to "development" for local/dev use, where the check never runs.
#
# P2-12: this file's own default used to be "development" -- meaning the
# guard built specifically to catch *this file's* placeholders could never
# fire in the file it exists for. A straight `cp .env.example .env` with no
# edits at all used to boot silently; now it fails loudly at startup with a
# clear "still has placeholder secrets" error instead. Change this back to
# "development" only once you have deliberately decided local/dev behavior
# is what you want, not by leaving it at whatever this file happened to ship.
ENVIRONMENT=production

# LiveKit (WebRTC SFU)
LIVEKIT_API_KEY=your_api_key_here
LIVEKIT_API_SECRET=your_api_secret_here
LIVEKIT_KEYS="your_api_key: your_api_secret"
LIVEKIT_URL=ws://livekit:7880
# URL returned to browsers; use the host's reachable name/IP for remote clients.
LIVEKIT_PUBLIC_URL=ws://127.0.0.1:7880

# PostgreSQL
POSTGRES_PASSWORD=your_password_here
DATABASE_URL=postgresql://ai_friend:${POSTGRES_PASSWORD}@127.0.0.1:5432/ai_friend_db
DIRECT_URL=postgresql://ai_friend:${POSTGRES_PASSWORD}@127.0.0.1:5432/ai_friend_db

# Local LLM
#
# P3-3 (M1-A3): left unset here on purpose. "Ollama host-native" is the
# documented default (CLAUDE.md), so this file used to hardcode
# `http://127.0.0.1:11434`, which is correct for a host-native Python run
# (and is also `Config.OLLAMA_URL`'s own built-in default, so leaving this
# unset changes nothing there) but wrong the moment brain_agent runs in
# Docker: 127.0.0.1 inside a container is the container itself, not the
# host. docker-compose.prod.yml's own OLLAMA_URL fallback
# (`http://host.docker.internal:11434`) is correct for that case, but only
# takes effect when this line does NOT set a value at all -- an explicit
# .env value always wins over a compose `${VAR:-default}`. Confirmed live:
# with the old value in place, brain_agent's bootstrap_runtime could never
# reach Ollama and crash-looped forever under restart: always.
#
# Uncomment ONE of these if you need to override the default for your setup
# (e.g. Ollama running somewhere other than the host, or the containerized
# `docker compose --profile docker-ollama` Ollama instead of host-native):
# OLLAMA_URL=http://127.0.0.1:11434       # host-native Python run, no Docker
# OLLAMA_URL=http://host.docker.internal:11434  # explicit (matches the compose default)
# OLLAMA_URL=http://local_brain:11434     # containerized Ollama (--profile docker-ollama)
OLLAMA_REQUIRED_MODELS=llama3.2:3b,nomic-embed-text

# Optional cloud LLM fallback (roadmap Phase 4.2), for hardware that can't
# host a local model. Leave LLM_PROVIDER unset/"ollama" for the default,
# fully local behaviour above. Setting it to "anthropic" sends conversation
# to a third party -- the opposite of this project's local-first default --
# so it is never on by default; this is your choice to make explicitly.
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your_anthropic_key_here
# LLM_CHAT_MODEL=claude-sonnet-5

# NATS
NATS_URL=nats://127.0.0.1:4222
# Required per-agent NATS credentials. `friend init` generates each password;
# Compose refuses to start the authenticated default mesh when any are empty.
# For deployments, supply these values through the secret manager.
NATS_PROVISIONER_USER=nats_provisioner
NATS_PROVISIONER_PASSWORD=
NATS_SIGNALING_USER=signaling
NATS_SIGNALING_PASSWORD=
NATS_BRAIN_USER=brain_agent
NATS_BRAIN_PASSWORD=
NATS_SUBCONSCIOUS_USER=subconscious_agent
NATS_SUBCONSCIOUS_PASSWORD=
NATS_SURFACING_USER=surfacing_agent
NATS_SURFACING_PASSWORD=
NATS_SYSTEM_USER=system_agent
NATS_SYSTEM_PASSWORD=
NATS_TRANSPORT_USER=transport_agent
NATS_TRANSPORT_PASSWORD=
NATS_STT_USER=stt_agent
NATS_STT_PASSWORD=
NATS_VISION_USER=vision_agent
NATS_VISION_PASSWORD=
NATS_VOICE_USER=voice_agent
NATS_VOICE_PASSWORD=

# Pinned Infra Image Tags (stability across environments)
NATS_IMAGE_TAG=2.10.24-alpine
NEO4J_IMAGE_TAG=5.26.0
LIVEKIT_IMAGE_TAG=v1.8.4
OLLAMA_IMAGE_TAG=0.5.7

# Neo4j Knowledge Graph
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_graph_password_here
NEO4J_AUTH=neo4j/your_graph_password_here
NEO4J_PLUGINS=["apoc"]

# Agent Identity
AI_NAME="AI Friend"
LOCATION_CONTEXT="Your City, State"

# Persona & Identity Storage (#113 / H2)
# All four are optional; unset reproduces the historical/default behaviour.
#
# PERSONA_PROFILE_PATH: an authored persona.toml (see backend/app/persona/).
#   Unset walks up from the working directory looking for config/persona.toml.
# BIOGRAPHY_PATH: an authored biography.md. Unset walks up for config/biography.md.
# PERSONALITY_SEED_PATH / HISTORY_SEED_PATH: the shipped, read-only
#   personality.json/history.json a fresh install seeds its runtime state
#   from. Unset uses the ones bundled in backend/app/.
# IDENTITY_BASE_PATH: where IdentityManager writes *runtime* persona
#   evolution (as opposed to the read-only seed above). Unset defaults to a
#   `.identity_state/` directory beside (not inside) backend/app/, kept out of
#   git the same way this repo already ignores its SQLite caches. In Docker,
#   point this at a mounted volume so persona evolution survives a container
#   rebuild, e.g.:
#   IDENTITY_BASE_PATH=/app/data
# PERSONA_PROFILE_PATH=
# BIOGRAPHY_PATH=
# PERSONALITY_SEED_PATH=
# HISTORY_SEED_PATH=
# IDENTITY_BASE_PATH=

# Voice Runtime
CUSTOM_GPT_PATH=GPT_weights/ai_friend_voice.ckpt
CUSTOM_SOVITS_PATH=SoVITS_weights/ai_friend_voice.pth
STT_LANGUAGE=en
# Fast-path acoustic perception. "on": use SenseVoice (emotion + audio events)
# when a model is present in STT_SENSEVOICE_DIR; "off": force the plain Whisper
# fast path (words only, no tone). Provision the model once on the host with:
#   python backend/scripts/bootstrap/provision_models.py
STT_SENSEVOICE=on
STT_SENSEVOICE_DIR=/app/models/sensevoice
TTS_LANGUAGE=en
SAMPLE_RATE=32000
VOICE_FILLER_THRESHOLD=1.2

# Voice Emotion Reference Clips (voice-agent)
# REF_AUDIO_PATH / REF_TEXT is the always-present neutral clip GPT-SoVITS
# conditions delivery on (path is read by the SoVITS *server*, not this
# process). The four *_CALM / *_WARM / *_CONCERNED / *_EXCITED pairs are
# optional overrides selected per turn from the agent's own affect state; an
# unset pair silently falls back to neutral, so leaving all four unset is a
# safe default and behaves exactly like the single-clip setup before this
# feature existed. Both members of a pair must be set together, or the whole
# pair is ignored (a lone audio path with no matching transcript is worse
# than falling back).
# REF_AUDIO_PATH=output/sample_en_gold.wav
# REF_TEXT=At the end of the exam, the program shows the performance summary.
# REF_AUDIO_PATH_CALM=output/calm.wav
# REF_TEXT_CALM=transcript of the calm reference clip
# REF_AUDIO_PATH_WARM=output/warm.wav
# REF_TEXT_WARM=transcript of the warm reference clip
# REF_AUDIO_PATH_CONCERNED=output/concerned.wav
# REF_TEXT_CONCERNED=transcript of the concerned reference clip
# REF_AUDIO_PATH_EXCITED=output/excited.wav
# REF_TEXT_EXCITED=transcript of the excited reference clip

# Voice Reliability (voice-agent) -- no fallback to a different engine/voice;
# these only govern same-engine recovery. Defaults shown are what the code
# uses if unset, so none of these need to be set explicitly.
# TTS_CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
# TTS_CIRCUIT_BREAKER_COOLDOWN_MS=15000
# 0 disables the background readiness probe -- useful in local dev without a
# real SoVITS server, where it would otherwise just warn every tick.
# TTS_READINESS_PROBE_INTERVAL_SECS=45

# Runtime Flags
RUNTIME_AUTO_BOOTSTRAP=true
RUNTIME_BOOTSTRAP_RETRIES=15
LLM_INTENT_CLASSIFICATION_ENABLED=false
REFLECTION_ENABLED=true
REFLECTION_MIN_INTERVAL_SECONDS=300
LAN_ONLY=true
# Shared secret required to mint a /token or /start-session session from any
# device other than the one running the backend (e.g. your phone over WiFi).
# Leave unset for single-machine use; required as soon as another device -
# or LAN_ONLY=false - needs to reach the backend. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
BACKEND_ACCESS_KEY=

# Caps how many /token or /start-session calls one client IP can make per
# window (H3). BACKEND_ACCESS_KEY says who may call it; this bounds how
# often, since a valid key doesn't imply unlimited LiveKit room creation.
TOKEN_RATE_LIMIT_MAX_REQUESTS=5
TOKEN_RATE_LIMIT_WINDOW_SECONDS=60

# Interface the FastAPI backend binds to when run directly (`python main.py`,
# not the Docker path -- Docker needs 0.0.0.0 regardless of this setting,
# since port publishing forwards to the container's interface, not loopback).
# Default is unchanged from before this existed. Set to 127.0.0.1 to restrict
# to same-machine callers, e.g. behind your own reverse proxy.
BACKEND_BIND_HOST=0.0.0.0

# Optional GPU Hints (leave empty for macOS CPU/Metal local runs)
NVIDIA_VISIBLE_DEVICES=
NVIDIA_DRIVER_CAPABILITIES=

# Proactive Speech
PROACTIVE_ENABLED=true
PROACTIVE_IDLE_THRESHOLD_SECONDS=7200
PROACTIVE_COOLDOWN_SECONDS=3600
PROACTIVE_MIN_ENERGY=0.2

# Observability
MESH_OBSERVED_SUBJECTS=system.tick,memory.surfaced,audio.stop,audio.resume,chat.output
SUBJECT_METRICS_LOG_EVERY=25

# Cognitive action selection (both enabled by default).
# Legacy PHASE_02_MEMORY_TRUTH / PHASE_03_AFFECT_CONTROL inputs are accepted.
# Use only these canonical names in new deployments.
MEMORY_TRUTH_ENABLED=true
AFFECT_CONTROL_ENABLED=true

# Brain V2 (docs/brain-research/05-brain-v2-architecture.md).
# Memory retrieval ranking: "hybrid" (default, ADR-001) or "actr_v1" (rollback).
MEMORY_RANKING_POLICY=hybrid
MEMORY_CANDIDATE_POOL=60
MEMORY_SQLITE_SCAN_LIMIT=5000
# Adapt appraisal weights from reappraisal outcomes (ADR-002: off; unstable).
REAPPRAISAL_WEIGHT_LEARNING_ENABLED=false
